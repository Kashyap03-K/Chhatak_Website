# Chhatak backend — environment template
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# ---- Resend (transactional email) ----
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Sender address shown to recipients.
#   Dev / pre-domain-verification: onboarding@resend.dev
#     (Resend's shared sender — only delivers to the email registered on your Resend account.)
#   Production (after verifying chhatak.co in Resend): hello@chhatak.co
FROM_EMAIL=onboarding@resend.dev

# ---- Frontend link base ----
# Used to build the verification link inside outgoing emails. Must match where users open the site.
#   Local dev:  http://localhost:5173
#   Production: https://chhatak.onrender.com  (replace with the real Render URL)
FRONTEND_URL=http://localhost:5173

# ---- Auth ----
# Signing key for JWT access tokens. Generate a strong random one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Render's render.yaml auto-generates this for the deployed service — set manually only for local dev.
SECRET_KEY=change-me-in-production-use-a-long-random-string

# JWT lifetime (minutes). 7 days by default.
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Database ----
# Local dev defaults to a SQLite file. Render injects a real Postgres URL in production.
DATABASE_URL=sqlite:///./chhatak.db
# DATABASE_URL=postgresql://chhatak:chhatak@localhost:5432/chhatak

# ---- Admin seed account ----
# seed.py upserts an admin with these credentials on every boot.
# Set strong values in production; leaving them unset uses the defaults inside seed.py.
# ADMIN_EMAIL=admin@chhatak.co
# ADMIN_PASSWORD=change-me
# ADMIN_NAME=Chhatak Admin

# ---- Razorpay (optional — leave blank while checkout is COD-only) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=
